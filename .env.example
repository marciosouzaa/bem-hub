# Supabase client configuration.
# Find these in Supabase Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only key used to read encrypted channel credentials and process webhooks.
# Prefer the current Supabase secret key. Never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Legacy fallback only:
# SUPABASE_SERVICE_ROLE_KEY=

# Stable public HTTPS origin used to register channel webhooks.
# Production example: https://app.example.com (without a trailing slash).
APP_BASE_URL=

# Public HTTPS application URL used by existing-user team invitation links.
# Production example: https://bem-hub.vercel.app/app
BEM_HUB_PRODUCTION_APP_URL=

# Managed WhatsApp provisioning. These values are server-only.
# Customers never receive the admin token or per-instance credentials.
WHATSAPP_MANAGED_PROVISIONING_ENABLED=false
WHATSAPP_MANAGED_PROVIDER=wuzapi
WUZAPI_MANAGED_BASE_URL=
WUZAPI_ADMIN_TOKEN=
# Development only: optional path to a Wuzapi .env containing WUZAPI_ADMIN_TOKEN.
WUZAPI_LOCAL_ENV_FILE=
EVOLUTION_MANAGED_BASE_URL=
EVOLUTION_API_KEY=
# Development only: optional path to an Evolution .env containing AUTHENTICATION_API_KEY.
EVOLUTION_LOCAL_ENV_FILE=

# Legacy fallback only. Prefer NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY for new envs.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required to encrypt AI provider keys saved by workspace admins.
# Use a long random value and keep it stable across deploys.
APP_ENCRYPTION_KEY=

# Legacy development fallbacks for /api/chat when an assistant has no provider connection.
# Production should prefer keys saved in /app/settings/ai-providers.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional legacy override for the default chat model.
OPENAI_CHAT_MODEL=gpt-5.5

# Optional local RAG benchmark. Use a short-lived user access token; never commit it.
BEM_HUB_BENCHMARK_ACCESS_TOKEN=
BEM_HUB_BENCHMARK_ORGANIZATION_ID=
# BEM_HUB_BENCHMARK_ASSISTANT_ID=
